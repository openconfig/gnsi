load("@com_github_grpc_grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "auditz_proto",
    srcs = [
        "auditz.proto",
    ],
    import_prefix = "github.com/openconfig/gnsi",
    deps = [
        "@com_google_protobuf//:timestamp_proto",
        "@openconfig_gnmi//proto/gnmi:gnmi_proto",
    ],
)

##############################################################################
# C++
##############################################################################
cc_proto_library(
    name = "auditz_cc_proto",
    deps = [":auditz_proto"],
)

cc_grpc_library(
    name = "auditz_cc_grpc_proto",
    srcs = [":auditz_proto"],
    grpc_only = True,
    deps = [":auditz_cc_proto"],
)

##############################################################################
# Go
##############################################################################
go_proto_library(
    name = "auditz_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "@io_bazel_rules_go//proto:go_proto",
    ],
    importpath = "github.com/openconfig/gnsi/auditz",
    proto = ":auditz_proto",
    deps = [
        "@openconfig_gnmi//proto/gnmi",
    ],
)

go_library(
    name = "auditz",
    embed = [":auditz_go_proto"],
    importpath = "github.com/openconfig/gnsi/auditz",
)
